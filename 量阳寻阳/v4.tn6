{ VOLUP X YANG X SHIPAN v4版(开盘增强) }

{ 1. 基础定义 }
V_MA20 := MA(VOL, 20);
HIGH_250 := HHV(H, 250);
MAX_OC := MAX(C, O);
MIN_OC := MIN(C, O);
UPPER_SHADOW := H - MAX_OC;
LOWER_SHADOW := MIN_OC - L;
BODY := ABS(C - O);
DAY_RANGE := MAX(H - L, 0.01);
PCT_CHG := (C - REF(C, 1)) / REF(C, 1) * 100;

{ 2. 试盘信号定义 }
LOW_POS := C < HIGH_250 * 0.8;
COND_LIMIT := LOW_POS AND PCT_CHG > 7.0 AND VOL > V_MA20 * 1.3;
COND_UPPER := LOW_POS AND (H-MAX_OC) > BODY * 1.5 AND (H-MAX_OC) > DAY_RANGE * 0.4 AND VOL > V_MA20 * 1.5;
COND_LOWER := LOW_POS AND (MIN_OC-L) > BODY * 1.5 AND VOL > V_MA20 * 1.1;
SHIPAN_COUNT := COUNT(COND_LIMIT OR COND_UPPER OR COND_LOWER, 45);

{ --- 板块过滤逻辑 --- }
IS_MAIN_BOARD := NOT(CODELIKE('30')) AND NOT(CODELIKE('68'));
NOT_ST := IF(NAMELIKE('ST'), 0, 1) AND IF(NAMELIKE('*ST'), 0, 1);

{ 3. 核心选股条件 }
{ T日: 高开 }
T0_OPEN_HIGH := O >= REF(C, 1);

{ T-1日: 昨日缩量，收阳，实体突破 }
T1_VOL_LESS := REF(V, 1) < REF(V, 2);
T1_YANG := REF(C, 1) > REF(O, 1);
T1_TOP_UP := REF(MAX_OC, 1) > REF(MAX_OC, 2);

{ T-2日: 前日爆量 }
T2_VOL_BREAK := REF(V, 2) > REF(V, 3) AND REF(V, 2) > REF(V, 4) AND REF(V, 2) > REF(V, 5);

{ 重心条件: MP1 > MP2 > MP3 }
MP1 := (REF(C, 1) + REF(O, 1)) / 2;
MP2 := (REF(C, 2) + REF(O, 2)) / 2;
MP3 := (REF(C, 3) + REF(O, 3)) / 2;
CENTER_COND := MP1 > MP2 AND MP2 > MP3;

{ 倍量前的缩量: V3<V2, V4<V2, V5<V2 }
PRE_VOL_LESS := REF(V, 3) < REF(V, 2) AND REF(V, 4) < REF(V, 2) AND REF(V, 5) < REF(V, 2);

{ 4. 汇总判断 }
IS_MATCH := T0_OPEN_HIGH AND T1_VOL_LESS AND T1_YANG AND T1_TOP_UP AND T2_VOL_BREAK AND CENTER_COND AND PRE_VOL_LESS AND SHIPAN_COUNT >= 1 AND IS_MAIN_BOARD AND NOT_ST;

{ --- 计算排序比值 --- }
MAX_PRE_V := MAX(REF(V,3), MAX(REF(V,4), REF(V,5)));
爆量高比: IF(IS_MATCH, REF(V,2) / MAX_PRE_V, 0);
